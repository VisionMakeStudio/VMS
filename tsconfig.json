{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@netlify/functions": ["types/netlify-functions.d.ts"]
    }
  },
  "include": ["types/**/*.d.ts", "netlify/functions/**/*.mts"]
}
