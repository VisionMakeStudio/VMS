import type { Config } from "@netlify/functions";
import { requireAdmin } from "./_shared/auth.mts";
import { cents, jsonError, stripeRequest, supabaseJson, supabaseWrite } from "./_shared/billing.mts";

type Row=Record<string,any>;
const clean=(v:any,n=2000)=>String(v??'').trim().slice(0,n);
const now=()=>new Date().toISOString();
const money=(v:any,c='USD')=>{try{return new Intl.NumberFormat('en-US',{style:'currency',currency:String(c||'USD').toUpperCase()}).format(Number(v)||0)}catch{return `$${Number(v||0).toFixed(2)}`}};

async function ensureCustomer(client:Row){const rows=await supabaseJson(`billing_customers?client_id=eq.${encodeURIComponent(client.id)}&select=*&limit=1`);if(rows?.[0]?.provider_customer_id)return rows[0].provider_customer_id;const p=new URLSearchParams();p.set('email',client.owner_email);p.set('name',client.business_name||client.contact_name||client.owner_email);p.set('metadata[client_id]',client.id);p.set('metadata[vms_business_name]',client.business_name||'');const customer=await stripeRequest('customers',p);await supabaseWrite('billing_customers?on_conflict=client_id','POST',{client_id:client.id,provider:'stripe',provider_customer_id:customer.id,email:client.owner_email,metadata:{livemode:!!customer.livemode},updated_at:now()},'resolution=merge-duplicates,return=minimal');return customer.id as string}
async function getClient(id:string){const rows=await supabaseJson(`clients?id=eq.${encodeURIComponent(id)}&select=*&limit=1`);if(!rows?.[0])throw Object.assign(new Error('Client not found.'),{status:404});return rows[0]}
async function getClientService(clientId:string,serviceId?:string,serviceKey?:string){let path='';if(serviceId)path=`client_services?id=eq.${encodeURIComponent(serviceId)}&client_id=eq.${encodeURIComponent(clientId)}&select=*&limit=1`;else path=`client_services?client_id=eq.${encodeURIComponent(clientId)}&service_key=eq.${encodeURIComponent(serviceKey||'')}&select=*&limit=1`;const rows=await supabaseJson(path);if(!rows?.[0])throw Object.assign(new Error('Client service not found.'),{status:404});return rows[0]}
async function getCatalog(service:Row){const key=service.catalog_service_id||service.service_key;const rows=await supabaseJson(`service_catalog?id=eq.${encodeURIComponent(key)}&select=*&limit=1`);return rows?.[0]||null}
async function queue(ruleKey:string,clientId:string,sourceType:string,sourceId:string,subject:string,message:string,metadata:Row={}){return supabaseWrite('automation_event_queue','POST',{rule_key:ruleKey,event_key:`${ruleKey}:${sourceType}:${sourceId}`,client_id:clientId,source_type:sourceType,source_id:sourceId,subject,message,needs_action:false,metadata,status:'pending',next_attempt_at:now(),updated_at:now()},'return=minimal').catch(()=>null)}

async function maybeCreateJob(client:Row,service:Row,catalog:Row|null){const family=String(catalog?.metadata?.family||service?.metadata?.family||'').toLowerCase();const auto=new Set(['audit','website','local','reviews','package','bundle']);if(!auto.has(family)&&catalog?.metadata?.optionalLabor!==true)return null;const key=service.catalog_service_id||service.service_key;const existing=await supabaseJson(`service_jobs?client_id=eq.${encodeURIComponent(client.id)}&catalog_service_id=eq.${encodeURIComponent(key)}&source=eq.billing&status=not.eq.canceled&select=id&limit=1`).catch(()=>[]);if(existing?.[0])return existing[0];const rows=await supabaseWrite('service_jobs','POST',{client_id:client.id,catalog_service_id:key,service_name:service.service_name,title:`${service.service_name} · ${client.business_name}`,status:'draft',priority:'normal',timezone:'America/New_York',location_type:'remote',client_visible:true,source:'billing',internal_notes:'Created automatically after payment confirmation.'});return rows?.[0]||null}

async function activateService(client:Row,service:Row,amount:number,provider:string,reference:string){const catalog=await getCatalog(service);const recurring=/recurring/i.test(String(catalog?.pricing_model||service.billing_cadence||''));await supabaseWrite(`client_services?id=eq.${encodeURIComponent(service.id)}`,'PATCH',{service_status:'active',billing_status:'active',agreed_price:amount||service.agreed_price,price_locked:true,start_date:service.start_date||new Date().toISOString().slice(0,10),metadata:{...(service.metadata||{}),payment_required:false,billingProvider:provider,last_payment_reference:reference},updated_at:now()},'return=minimal');if(recurring&&provider==='manual'){const existing=await supabaseJson(`billing_subscriptions?client_service_id=eq.${encodeURIComponent(service.id)}&provider=eq.manual&select=id&limit=1`);const payload={client_id:client.id,client_service_id:service.id,provider:'manual',status:'active',amount:amount||Number(service.agreed_price)||0,currency:'USD',cadence:service.billing_cadence||catalog?.cadence||'Monthly',metadata:{service_key:service.service_key,service_name:service.service_name},updated_at:now()};if(existing?.[0])await supabaseWrite(`billing_subscriptions?id=eq.${encodeURIComponent(existing[0].id)}`,'PATCH',payload,'return=minimal');else await supabaseWrite('billing_subscriptions','POST',payload,'return=minimal')}
  await maybeCreateJob(client,service,catalog);
}

async function listAll(){const[clients,services,catalog,subs,invoices,payments,customers]=await Promise.all([supabaseJson('clients?select=*&order=created_at.desc'),supabaseJson('client_services?select=*&order=created_at.desc'),supabaseJson('service_catalog?select=*&order=display_order.asc'),supabaseJson('billing_subscriptions?select=*&order=created_at.desc'),supabaseJson('billing_invoices?select=*&order=created_at.desc'),supabaseJson('billing_payments?select=*&order=created_at.desc').catch(()=>[]),supabaseJson('billing_customers?select=*&order=created_at.desc')]);return{clients,services,catalog,subscriptions:subs,invoices,payments,customers}}

async function createInvoice(req:Request,b:Row){const client=await getClient(clean(b.clientId,80)),service=await getClientService(client.id,clean(b.clientServiceId,80),clean(b.serviceKey,120)),catalog=await getCatalog(service);if(/recurring/i.test(String(catalog?.pricing_model||'')))throw Object.assign(new Error('Use Send Payment Request for recurring services; Stripe Checkout creates the subscription.'),{status:409});const amount=Number(b.amount??service.agreed_price??catalog?.one_time_price);if(!Number.isFinite(amount)||amount<=0)throw Object.assign(new Error('Invoice amount must be greater than $0.'),{status:400});const customerId=await ensureCustomer(client),dueDays=Math.max(1,Math.min(90,Math.round(Number(b.dueDays)||14)));const item=new URLSearchParams();item.set('customer',customerId);item.set('amount',String(cents(amount)));item.set('currency','usd');item.set('description',clean(b.description||service.service_name,500));item.set('metadata[client_id]',client.id);item.set('metadata[service_key]',service.service_key);await stripeRequest('invoiceitems',item);const p=new URLSearchParams();p.set('customer',customerId);p.set('collection_method','send_invoice');p.set('days_until_due',String(dueDays));p.set('auto_advance','false');p.set('metadata[client_id]',client.id);p.set('metadata[service_key]',service.service_key);p.set('metadata[service_name]',service.service_name);p.set('description',clean(b.note||`Vision Make Studio · ${service.service_name}`,500));const draft=await stripeRequest('invoices',p);const invoice=await stripeRequest(`invoices/${encodeURIComponent(draft.id)}/finalize`,new URLSearchParams());const dueAt=invoice.due_date?new Date(invoice.due_date*1000).toISOString():new Date(Date.now()+dueDays*86400000).toISOString();const rows=await supabaseWrite('billing_invoices?on_conflict=provider_invoice_id','POST',{client_id:client.id,client_service_id:service.id,service_key:service.service_key,provider:'stripe',provider_invoice_id:invoice.id,invoice_number:invoice.number||null,status:String(invoice.status||'open'),amount_due:Number(invoice.amount_due||0)/100,amount_paid:Number(invoice.amount_paid||0)/100,currency:String(invoice.currency||'usd').toUpperCase(),issued_at:new Date((invoice.created||Date.now()/1000)*1000).toISOString(),due_at:dueAt,hosted_invoice_url:invoice.hosted_invoice_url||null,invoice_pdf_url:invoice.invoice_pdf||null,metadata:{service_key:service.service_key,service_name:service.service_name,created_by:'vms_admin'},updated_at:now()},'resolution=merge-duplicates,return=representation');const saved=rows?.[0];await supabaseWrite(`client_services?id=eq.${encodeURIComponent(service.id)}`,'PATCH',{service_status:'pending',billing_status:'awaiting_payment',metadata:{...(service.metadata||{}),payment_required:true,invoice_id:saved?.id||null,provider_invoice_id:invoice.id},updated_at:now()},'return=minimal');const url=invoice.hosted_invoice_url||`${new URL(req.url).origin}/portal/?section=billing`;await queue('invoice_ready',client.id,'billing_invoice',saved?.id||invoice.id,`VMS invoice ready · ${service.service_name}`,`${client.business_name}, your invoice for ${service.service_name} (${money(amount)}) is ready. Open the secure payment page to review and pay.`,{invoice_id:saved?.id||null,provider_invoice_id:invoice.id,hosted_invoice_url:url,invoice_url:url,service_key:service.service_key});return{invoice:saved||invoice,hostedInvoiceUrl:url}}

async function sendPaymentRequest(req:Request,b:Row){const client=await getClient(clean(b.clientId,80)),service=await getClientService(client.id,clean(b.clientServiceId,80),clean(b.serviceKey,120));await supabaseWrite(`client_services?id=eq.${encodeURIComponent(service.id)}`,'PATCH',{service_status:'pending',billing_status:'awaiting_payment',metadata:{...(service.metadata||{}),payment_required:true,payment_request_sent_at:now()},updated_at:now()},'return=minimal');const url=`${new URL(req.url).origin}/portal/?section=billing`;await queue('payment_request',client.id,'client_service',service.id,`Ready for payment · ${service.service_name}`,`${client.business_name}, ${service.service_name} is approved and ready for payment. Sign in to your VMS Client Portal to securely pay and activate it.`,{url,service_key:service.service_key,client_service_id:service.id});return{sent:true,url}}

async function manualPayment(b:Row){const client=await getClient(clean(b.clientId,80)),service=await getClientService(client.id,clean(b.clientServiceId,80),clean(b.serviceKey,120));const invoiceId=clean(b.invoiceId,80)||null,amount=Number(b.amount??service.agreed_price);if(!Number.isFinite(amount)||amount<=0)throw Object.assign(new Error('Payment amount must be greater than $0.'),{status:400});const method=clean(b.method||'Other',80),ref=`manual:${crypto.randomUUID()}`;let invoice:Row|null=null;if(invoiceId){const rows=await supabaseJson(`billing_invoices?id=eq.${encodeURIComponent(invoiceId)}&client_id=eq.${encodeURIComponent(client.id)}&select=*&limit=1`);invoice=rows?.[0]||null}const payments=await supabaseWrite('billing_payments','POST',{client_id:client.id,client_service_id:service.id,invoice_id:invoice?.id||null,provider:'manual',provider_payment_id:ref,amount,currency:'USD',status:'paid',method,description:clean(b.description||service.service_name,500),paid_at:now(),metadata:{note:clean(b.note,1000),recorded_by:'vms_admin'},updated_at:now()});if(invoice?.id)await supabaseWrite(`billing_invoices?id=eq.${encodeURIComponent(invoice.id)}`,'PATCH',{status:'paid',amount_paid:amount,paid_at:now(),updated_at:now()},'return=minimal');await activateService(client,service,amount,'manual',ref);const payment=payments?.[0];await queue('payment_received',client.id,'billing_payment',payment?.id||ref,`Payment received · ${service.service_name}`,`${money(amount)} received for ${service.service_name} via ${method}. The VMS service is now active.`,{payment_id:payment?.id||null,amount,currency:'USD',service_key:service.service_key,method});return{payment}}

async function voidInvoice(b:Row){const id=clean(b.invoiceId,80);const rows=await supabaseJson(`billing_invoices?id=eq.${encodeURIComponent(id)}&select=*&limit=1`),invoice=rows?.[0];if(!invoice)throw Object.assign(new Error('Invoice not found.'),{status:404});if(invoice.provider==='stripe'&&invoice.provider_invoice_id&&invoice.status==='open')await stripeRequest(`invoices/${encodeURIComponent(invoice.provider_invoice_id)}/void`,new URLSearchParams());await supabaseWrite(`billing_invoices?id=eq.${encodeURIComponent(id)}`,'PATCH',{status:'void',updated_at:now()},'return=minimal');return{voided:true}}

export default async(req:Request)=>{try{await requireAdmin(req);if(req.method==='GET')return Response.json(await listAll());if(req.method!=='POST')return Response.json({error:'Method not allowed.'},{status:405});const b=await req.json().catch(()=>({})),a=clean(b.action,60);if(a==='create-invoice')return Response.json({ok:true,...await createInvoice(req,b)});if(a==='send-payment-request')return Response.json({ok:true,...await sendPaymentRequest(req,b)});if(a==='manual-payment')return Response.json({ok:true,...await manualPayment(b)});if(a==='void-invoice')return Response.json({ok:true,...await voidInvoice(b)});return Response.json({error:'Unknown billing action.'},{status:400})}catch(e){return jsonError(e)}};
export const config:Config={path:'/api/admin-billing'};
