async function supabase(path:string){
  const url=env("SUPABASE_URL"),key=env("SUPABASE_SERVICE_ROLE_KEY");
  if(!url||!key)throw new Error("VMS LinkHub is not configured.");
  const r=await fetch(`${url.replace(/\/$/,"")}/rest/v1/${path}`,{headers:{apikey:key,Authorization:`Bearer ${key}`,Accept:"application/json"}});
  if(!r.ok)throw new Error(`LinkHub lookup failed (${r.status}).`);return r.json();
}
