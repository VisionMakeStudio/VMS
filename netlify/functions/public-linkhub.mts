r-radius:999px;padding:9px 11px;font-weight:800}.menu-section button{width:100%;border:0;background:transparent;color:inherit;text-align:left;font:inherit;font-weight:900;font-size:17px;display:flex;justify-content:space-between;padding:0}.menu-items{display:none;margin-top:12px}.menu-section.open .menu-items{display:grid;gap:11px}.menu-item{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;border-top:1px solid color-mix(in srgb,currentColor 12%,transparent);padding-top:10px}.menu-item strong{display:block}.menu-item span{font-size:13px;opacity:.73;display:block;margin-top:3px;line-height:1.45}.price{font-weight:900;white-space:nowrap}@media(max-width:520px){body{padding-top:18px}.wifi-actions{grid-template-columns:1fr}.screen{padding-left:12px;padding-right:12px}}</style></head><body><main class="wrap"><div class="avatar">${photo?`<img src="${photo}" alt="${name}">`:escapeHtml(String(d.businessName||d.title||"B").split(/\s+/).slice(0,2).map((x:string)=>x[0]||"").join("").toUpperCase())}</div><h1>${name}</h1>${bio?`<div class="bio">${bio}</div>`:""}<div class="contact">${contact}</div>${featureButtons?`<div class="features">${featureButtons}</div>`:""}<div class="links">${links.map((l:any)=>`<a href="${escapeHtml(safeUrl(l.url))}" target="_blank" rel="noopener">${escapeHtml(l.label||l.type||"Open")}</a>`).join("")}</div>${socials.length?`<div class="socials">${socials.map((s:any)=>`<a href="${escapeHtml(safeUrl(s.url))}" target="_blank" rel="noopener" aria-label="${escapeHtml(s.label||s.platform||"Social link")}">${socialIcon(s.platform)}</a>`).join("")}</div>`:""}<div class="powered">VMS LinkHub · Smart Business Card by Vision Make Studio</div></main><section class="screen" id="screen-wifi"><div class="screen-inner"><button class="back" data-back type="button">← Back</button><h2>Guest Wi-Fi</h2><p>Use the details below to connect to the guest network.</p><div class="wifi-card"><div class="wifi-row"><span>Network</span><strong>${escapeHtml(wifi.ssid||"Guest Wi-Fi")}</strong></div><div class="wifi-row"><span>Security</span><strong>${escapeHtml(wifi.security||"WPA2")}</strong></div><div class="wifi-row"><span>Password</span><strong id="wifiPassword">${wifi.revealOnTap!==false?'••••••••':escapeHtml(wifi.password||"")}</strong></div><div class="wifi-actions"><button id="showWifi" type="button">${wifi.revealOnTap!==false?'Show Password':'Hide Password'}</button><button id="copyWifi" type="button">Copy Password</button></div></div><p>On most phones, open Wi-Fi settings, choose the network above, then paste the password.</p></div></section><section class="screen" id="screen-menu"><div class="screen-inner"><button class="back" data-back type="button">← Back</button><div class="restaurant-head"><h2>${escapeHtml(restaurant.name||d.businessName||"Menu")}</h2>${restaurant.cuisine?`<p><strong>${escapeHtml(restaurant.cuisine)}</strong></p>`:""}${restaurant.description?`<p>${escapeHtml(restaurant.description)}</p>`:""}<div class="restaurant-actions">${restaurant.phone?`<a href="tel:${escapeHtml(String(restaurant.phone).replace(/[^\d+]/g,""))}">Call</a>`:""}${restaurant.website?`<a href="${escapeHtml(safeUrl(restaurant.website))}" target="_blank" rel="noopener">Website</a>`:""}${restaurant.reservationUrl?`<a href="${escapeHtml(safeUrl(restaurant.reservationUrl))}" target="_blank" rel="noopener">Reserve</a>`:""}${restaurant.orderUrl?`<a href="${escapeHtml(safeUrl(restaurant.orderUrl))}" target="_blank" rel="noopener">Order</a>`:""}</div>${restaurant.address?`<div class="info-card"><div class="info-row"><span>Address</span><strong>${escapeHtml(restaurant.address)}</strong></div>${restaurant.hours?`<div class="info-row"><span>Hours</span><strong>${escapeHtml(restaurant.hours)}</strong></div>`:""}</div>`:""}</div>${menuSections.map((sec:any)=>`<div class="menu-section"><button type="button"><span>${escapeHtml(sec.name||"Menu")}</span><span>⌄</span></button><div class="menu-items">${(Array.isArray(sec.items)?sec.items:[]).filter((i:an