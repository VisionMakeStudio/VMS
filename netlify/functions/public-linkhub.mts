export default async(req:Request)=>{
  if(req.method!=="GET")return new Response("Method not allowed",{status:405});
  try{
    const pathname=new URL(req.url).pathname,match=pathname.match(/^\/link\/([^/?#]+)\/?$/i),slug=decodeURIComponent(match?.[1]||"").toLowerCase();
    if(!slug)return unavailable();
    const rows=await supabase(`linkhub_pages?slug=eq.${encodeURIComponent(slug)}&status=eq.published&select=client_id,slug,published_data,published_at&limit=1`),row=Array.isArray(rows)?rows[0]:null;if(!row)return unavailable();
    const activeServices=await supabase(`client_services?client_id=eq.${encodeURIComponent(row.client_id)}&service_status=in.(active,published,enabled)&billing_status=in.(active,paid,trialing,gifted,comped)&select=service_key,catalog_service_id`);
    const keys=new Set((Array.isArray(activeServices)?activeServices:[]).flatMap((x:any)=>[x?.service_key,x?.catalog_service_id]).filter(Boolean).map((x:any)=>String(x).toLowerCase()));
    if(!keys.has("linkhub-core")&&!keys.has("linkhub-pro"))return unavailable();
    const data={...(row.published_data||{})};
    if(data.manualDisabled===true)return unavailable();
    if(!keys.has("linkhub-wifi"))data.wifi={...(data.wifi||{}),enabled:false};
    if(!keys.has("linkhub-menu"))data.restaurant={...(data.restaurant||{}),enabled:false};
    return new Response(render(data,row.slug),{status:200,headers:{"content-type":"text/html; charset=utf-8","cache-control":"public, max-age=60, s-maxage=120","x-content-type-options":"nosniff","referrer-policy":"strict-origin-when-cross-origin"}});
  }catch(e){console.error("VMS public LinkHub",e);return unavailable(503)}
};
