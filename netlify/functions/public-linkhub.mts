import type { Config } from "@netlify/functions";

function env(name:string){
  try{return Netlify.env.get(name)||""}catch{return ""}
}
function escapeHtml(value:any){return String(value??"").replace(/[&<>"']/g,(c)=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"} as Record<string,string>)[c]||c)}
function safeUrl(value:any){
  const raw=String(value||"").trim();if(!raw)return "#";
  if(/^(mailto:|tel:)/i.test(raw))return raw.replace(/["'<>\s]/g,"");
  try{const u=new URL(/^https?:\/\//i.test(raw)?raw:`https://${raw}`);return /^https?:$/.test(u.protocol)?u.href:"#"}catch{return "#"}
}
function safeDataImage(value:any){const raw=String(value||"");return /^data:image\/(png|jpe?g|webp|gif);base64,[a-z0-9+/=\s]+$/i.test(raw)?raw:""}
function cleanHex(value:any,fallback:string){const raw=String(value||"").trim();return /^#[0-9a-f]{6}$/i.test(raw)?raw.toUpperCase():fallback}
