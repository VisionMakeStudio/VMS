import { read, write, type AutomationRule, type Candidate } from './automations.mts';
import { deliverFinal, finalCapabilities, resetAutomationCaches } from './automation-delivery-final.mts';

type Row=Record<string,any>;type Totals={scanned:number;created:number;sent:number;skipped:number;failed:number;duplicates:number};
const TZ='America/New_York',clean=(v:any,n=5000)=>String(v??'').trim().slice(0,n),addMin=(d:Date,n:number)=>new Date(d.getTime()+n*60000),addDay=(d:Date,n:number)=>new Date(d.getTime()+n*86400000),iso=(d:Date)=>d.toISOString();
const when=(v:any)=>{const d=new Date(v);return Number.isNaN(d.getTime())?'—':d.toLocaleString('en-US',{timeZone:TZ,weekday:'short',month:'short',day:'numeric',hour:'numeric',minute:'2-digit',timeZoneName:'short'})};
const money=(v:any,c='USD')=>{try{return new Intl.NumberFormat('en-US',{style:'currency',currency:String(c||'USD').toUpperCase()}).format(Number(v)||0)}catch{return `$${Number(v||0).toFixed(2)}`}};
function total(){return{scanned:0,created:0,sent:0,skipped:0,failed:0,duplicates:0}}
function add(t:Totals,r:any){t.created+=r.created||0;t.sent+=r.sent||0;t.skipped+=r.skipped||0;t.failed+=r.failed||0;t.duplicates+=r.duplicates||0}
async function scheduled(r:AutomationRule,now=new Date()):Promise<Candidate[]>{const key=r.rule_key,lead=Number(r.lead_minutes||0),win=Number(r.config?.window_minutes||90),look=Number(r.config?.lookback_days||7);if(key==='appointment_24h'){const target=addMin(now,lead),a=addMin(target,-win/2),b=addMin(target,win/2),rows=await read(`service_jobs?status=in.(scheduled,confirmed)&client_visible=eq.true&scheduled_start=gte.${encodeURIComponent(iso(a))}&scheduled_start=lte.${encodeURIComponent(iso(b))}&select=id,client_id,title,service_name,status,scheduled_start,address`);return(rows||[]).map((j:Row)=>({clientId:j.client_id,sourceType:'service_job',sourceId:`${j.id}:${j.scheduled_start}`,subject:'Upcoming VMS service tomorrow',message:`${j.title||j.service_name} is scheduled for ${when(j.scheduled_start)}${j.address?` at ${j.address}`:''}.`,scheduledFor:j.scheduled_start,metadata:{job_id:j.id}}))}if(key==='invoice_due_3d'){const target=addMin(now,lead),a=addMin(target,-win/2),b=addMin(target,win/2),rows=await read(`billing_invoices?status=in.(open,past_due,unpaid)&due_at=gte.${encodeURIComponent(iso(a))}&due_at=lte.${encodeURIComponent(iso(b))}&select=id,client_id,invoice_number,amount_due,currency,due_at,hosted_invoice_url`);return(rows||[]).map((x:Row)=>({clientId:x.client_id,sourceType:'billing_invoice',sourceId:`${x.id}:${x.due_at}`,subject:'VMS invoice due soon',message:`Invoice ${x.invoice_number||''} for ${money(x.amount_due,x.currency)} is due ${when(x.due_at)}.`,needsAction:true,scheduledFor:x.due_at,metadata:{invoice_id:x.id,invoice_url:x.hosted_invoice_url||null}}))}if(key==='invoice_overdue'){const rows=await read(`billing_invoices?status=in.(open,past_due,unpaid)&due_at=not.is.null&due_at=lt.${encodeURIComponent(iso(now))}&select=id,client_id,invoice_number,amount_due,currency,due_at,hosted_invoice_url`);return(rows||[]).map((x:Row)=>({clientId:x.client_id,sourceType:'billing_invoice',sourceId:`${x.id}:${x.due_at}`,subject:'VMS invoice overdue',message:`Invoice ${x.invoice_number||''} for ${money(x.amount_due,x.currency)} is overdue since ${when(x.due_at)}.`,needsAction:true,metadata:{invoice_id:x.id,invoice_url:x.hosted_invoice_url||null}}))}if(key==='renewal_3d'){const target=addMin(now,lead),a=addMin(target,-win/2),b=addMin(target,win/2),rows=await read(`billing_subscriptions?status=in.(active,trialing)&cancel_at_period_end=eq.false&current_period_end=gte.${encodeURIComponent(iso(a))}&current_period_end=lte.${encodeURIComponent(iso(b))}&select=id,client_id,amount,currency,current_period_end,metadata`);return(rows||[]).map((s:Row)=>({clientId:s.client_id,sourceType:'billing_subscription',sourceId:`${s.id}:${s.current_period_end}`,subject:'Upcoming VMS subscription renewal',message:`${s.metadata?.service_name||'Your VMS subscription'} is scheduled to renew ${when(s.current_period_end)} for ${money(s.amount,s.currency)}.`,scheduledFor:s.current_period_end,metadata:{subscription_id:s.id}}))}if(key==='abandoned_checkout_2h'){const before=addMin(now,-Math.max(lead,120)),since=addDay(now,-look),rows=await read(`billing_checkout_sessions?status=in.(open,pending,created)&created_at=gte.${encodeURIComponent(iso(since))}&created_at=lte.${encodeURIComponent(iso(before))}&select=provider_session_id,client_id,service_key,metadata`);return(rows||[]).map((s:Row)=>({clientId:s.client_id,sourceType:'checkout_session',sourceId:s.provider_session_id,subject:'Finish your VMS service checkout',message:`Your checkout for ${s.metadata?.service_name||s.service_key||'a VMS service'} is still open. You can return to your VMS Portal when you're ready to continue.`,metadata:{provider_session_id:s.provider_session_id}}))}if(key==='onboarding_due_24h'){const cut=addMin(now,Math.max(lead,1440)),rows=await read(`client_onboarding_tasks?required=eq.true&status=in.(pending,in_progress)&due_at=not.is.null&due_at=lte.${encodeURIComponent(iso(cut))}&select=id,client_id,title,description,due_at`);return(rows||[]).map((t:Row)=>({clientId:t.client_id,sourceType:'onboarding_task',sourceId:`${t.id}:${t.due_at}`,subject:'VMS onboarding item needs attention',message:`${t.title} is ${new Date(t.due_at).getTime()<now.getTime()?'overdue':'due soon'} (${when(t.due_at)}).${t.description?` ${t.description}`:''}`,needsAction:true,scheduledFor:t.due_at,metadata:{task_id:t.id}}))}return[]}
async function relevant(q:Row){const r=String(q.rule_key||'');if(q.source_type==='booking_request'){const x=(await read(`booking_requests?id=eq.${encodeURIComponent(q.source_id)}&select=status&limit=1`))?.[0];if(!x)return false;if(r.endsWith('_admin'))return['new','reviewing'].includes(x.status);if(r.includes('decision_client'))return['approved','declined'].includes(x.status)}if(q.source_type==='service_job'){const x=(await read(`service_jobs?id=eq.${encodeURIComponent(q.source_id)}&select=status&limit=1`))?.[0];if(!x)return false;if(r==='project_ready')return x.status==='ready';if(r==='job_canceled_client')return x.status==='canceled'}if(q.source_type==='client_onboarding'){const x=(await read(`client_onboarding?client_id=eq.${encodeURIComponent(q.client_id||'none')}&select=status,portal_invited_at&limit=1`))?.[0];if(!x)return false;if(r==='onboarding_complete')return x.status==='complete';if(r==='onboarding_welcome')return!!x.portal_invited_at}if(q.source_type==='billing_event'&&r==='payment_failed'){const id=clean(q.metadata?.provider_invoice_id,220);if(id){const x=(await read(`billing_invoices?provider_invoice_id=eq.${encodeURIComponent(id)}&select=status&limit=1`))?.[0];if(x?.status==='paid')return false}}return true}
export async function processFinalEventQueue(limit=75){resetAutomationCaches();const t=total(),rows=await read(`automation_event_queue?status=in.(pending,retry)&next_attempt_at=lte.${encodeURIComponent(new Date().toISOString())}&select=*&order=created_at.asc&limit=${Math.max(1,Math.min(100,limit))}`);for(const q of rows||[]){t.scanned++;const rule=(await read(`automation_rules?rule_key=eq.${encodeURIComponent(q.rule_key)}&enabled=eq.true&trigger_type=eq.event&select=*&limit=1`))?.[0] as AutomationRule|undefined;if(!rule||!(await relevant(q))){await write(`automation_event_queue?id=eq.${encodeURIComponent(q.id)}`,'PATCH',{status:'done',processed_at:new Date().toISOString(),last_error:rule?'Suppressed because the source is no longer actionable.':'Rule disabled or missing.',updated_at:new Date().toISOString()},'return=minimal');continue}await write(`automation_event_queue?id=eq.${encodeURIComponent(q.id)}`,'PATCH',{status:'processing',updated_at:new Date().toISOString()},'return=minimal');const x=await deliverFinal(rule,{clientId:q.client_id,sourceType:q.source_type,sourceId:q.event_key,subject:q.subject,message:q.message,needsAction:!!q.needs_action,metadata:{...(q.metadata||{}),queue_id:q.id}});add(t,x);const attempts=Number(q.attempts||0)+1;if(x.failed>0&&attempts<3){await write(`automation_event_queue?id=eq.${encodeURIComponent(q.id)}`,'PATCH',{status:'retry',attempts,next_attempt_at:addMin(new Date(),[5,15][attempts-1]||60).toISOString(),last_error:'Delivery failed; automatic retry scheduled.',updated_at:new Date().toISOString()},'return=minimal')}else await write(`automation_event_queue?id=eq.${encodeURIComponent(q.id)}`,'PATCH',{status:x.failed?'failed':'done',attempts,processed_at:new Date().toISOString(),last_error:x.failed?'Delivery failed after retry limit.':null,updated_at:new Date().toISOString()},'return=minimal')}return t}
export async function runFinalAutomationCycle(source:'scheduled'|'manual'='scheduled'){resetAutomationCaches();const t=total(),row=(await write('automation_runs','POST',{source,status:'running',started_at:new Date().toISOString(),metadata:{engine:'phase7-final-v2'}}))?.[0];try{const rules=await read('automation_rules?enabled=eq.true&trigger_type=eq.scheduled&select=*&order=category.asc,name.asc') as AutomationRule[];for(const r of rules||[]){const cs=await scheduled(r);t.scanned+=cs.length;for(const c of cs)add(t,await deliverFinal(r,c))}const q=await processFinalEventQueue(75);t.scanned+=q.scanned;add(t,q);if(row?.id)await write(`automation_runs?id=eq.${encodeURIComponent(row.id)}`,'PATCH',{status:t.failed?'partial':'completed',completed_at:new Date().toISOString(),scanned_count:t.scanned,created_count:t.created,sent_count:t.sent,skipped_count:t.skipped,failed_count:t.failed,metadata:{duplicates:t.duplicates,engine:'phase7-final-v2'}},'return=minimal');return t}catch(e:any){if(row?.id)await write(`automation_runs?id=eq.${encodeURIComponent(row.id)}`,'PATCH',{status:'failed',completed_at:new Date().toISOString(),error:clean(e?.message||e,1500),metadata:{duplicates:t.duplicates,engine:'phase7-final-v2'}},'return=minimal').catch(()=>null);throw e}}
export async function emitFinalEvent(ruleKey:string,c:Candidate){resetAutomationCaches();const r=(await read(`automation_rules?rule_key=eq.${encodeURIComponent(ruleKey)}&enabled=eq.true&trigger_type=eq.event&select=*&limit=1`))?.[0] as AutomationRule|undefined;if(!r)throw Object.assign(new Error('That event automation is disabled or unavailable.'),{status:400});return deliverFinal(r,c)}
export const finalAutomationCapabilities=finalCapabilities;
